//@version=6
// ============================================================================
//  UT Bot + 平均線(25/75/200) + 前日/当日 高値・安値 + 水平線
//   - UT Bot: ATR トレーリングストップ。終値がストップを上抜け=Buy / 下抜け=Sell
//   - 平均線: 25 / 75 / 200 (SMA / EMA 切替)
//   - 高値・安値: 前日・当日 (UTC日。日の起点は変更可)
//   - 水平線: 任意の価格を最大3本 (0 = 非表示)
//   - ストキャス(4時間足): 底(7)以下でGC → 背景緑 / 天井(93)以上でDC → 背景赤
//     (次の反対シグナルが出るまで色を維持)
//   - 高値・安値の数字: ジグザグで天井と底を交互に判定して価格を表示 (白・太字)
//     一定の幅(ATR倍数 or pips)だけ反転したら天井/底を確定。天天・底底にはならない
//   - 表示範囲の最高値・最安値: DMM のように画面内の一番高い/安い足に価格を表示
//   - アラート: UT Buy/Sell, 前日高値/安値ブレイク, 4H ストキャス GC/DC
// ============================================================================
indicator("UT Bot + MA + H/L + 水平線", overlay=true, max_labels_count=500, max_lines_count=500)

// ---------------- Inputs ----------------
gU = "UT Bot"
keyValue = input.float(1.0, "Key Value (感度: 小さいほど敏感)", step=0.1, minval=0.1, group=gU)
atrLen   = input.int(10, "ATR 期間", minval=1, group=gU)
useHA    = input.bool(false, "平均足(Heikin Ashi)の終値を使う", group=gU)
showUT   = input.bool(true, "トレーリングストップ線を描画", group=gU)
barCol   = input.bool(false, "ローソク足を UT の方向で色分け", group=gU)

gM = "平均線"
maType = input.string("SMA", "種類", options=["SMA", "EMA"], group=gM)
len1   = input.int(25,  "MA1", minval=1, inline="m1", group=gM)
show1  = input.bool(true, "", inline="m1", group=gM)
len2   = input.int(75,  "MA2", minval=1, inline="m2", group=gM)
show2  = input.bool(true, "", inline="m2", group=gM)
len3   = input.int(200, "MA3", minval=1, inline="m3", group=gM)
show3  = input.bool(true, "", inline="m3", group=gM)
maW    = input.int(2, "太さ", minval=1, maxval=4, group=gM)

gH = "高値・安値"
showPD      = input.bool(true, "前日高値/安値", group=gH)
showCD      = input.bool(true, "当日高値/安値 (形成中)", group=gH)
showLbl     = input.bool(true, "価格ラベルを表示", group=gH)
dayStartUTC = input.int(0, "日の起点 (UTC時)  [0 = UTC日 / 22 = NYクローズ]", minval=0, maxval=23, group=gH)
hiCol       = input.color(color.blue, "高値の色", inline="hc", group=gH)
loCol       = input.color(color.red,  "安値の色", inline="hc", group=gH)

gS = "ストキャス (背景)"
showBG  = input.bool(true, "GC=緑 / DC=赤 の背景を表示", group=gS)
stMode  = input.string("天井・底ゾーン", "判定", options=["天井・底ゾーン", "全クロス"], group=gS)
stHi    = input.float(93, "天井 (この値以上で DC)", minval=50, maxval=100, group=gS)
stLo    = input.float(7,  "底 (この値以下で GC)",   minval=0,  maxval=50,  group=gS)
stTF    = input.timeframe("240", "時間足", group=gS)
kLen    = input.int(14, "%K 期間", minval=1, group=gS)
kSm     = input.int(3,  "%K スムージング", minval=1, group=gS)
dSm     = input.int(3,  "%D 期間", minval=1, group=gS)
stConf  = input.bool(true, "確定した足で判定 (リペイントなし)", group=gS)
bgTransp = input.int(85, "背景の透明度", minval=0, maxval=100, group=gS)

gP = "高値・安値の数字 (ジグザグ)"
showZZ    = input.bool(true, "ジグザグの天井・底に価格を表示", group=gP)
zzMode    = input.string("ATR倍数", "反転の幅の決め方", options=["ATR倍数", "pips"], group=gP)
zzAtrMult = input.float(2.0, "ATR 倍数 (大きいほど数字が減る)", step=0.5, minval=0.5, group=gP)
zzAtrLen  = input.int(14, "ATR 期間", minval=1, group=gP)
zzPips    = input.float(50, "pips (大きいほど数字が減る)", step=5, minval=1, group=gP)
zzPip     = input.float(0.01, "1 pip  (0.01 = JPYペア / 0.0001 = その他)", group=gP)
zzLine    = input.bool(true, "ジグザグ線を描画", group=gP)
zzLineCol = input.color(color.new(color.white, 50), "ジグザグ線の色", group=gP)
pivSize   = input.string("normal", "文字サイズ", options=["small", "normal", "large"], group=gP)
showVis   = input.bool(true, "表示範囲の最高値/最安値を表示 (DMM風)", group=gP)

gL = "水平線 (0 = 非表示)"
h1 = input.price(0.0, "水平線1", inline="h1", group=gL)
c1 = input.color(color.gray,   "", inline="h1", group=gL)
h2 = input.price(0.0, "水平線2", inline="h2", group=gL)
c2 = input.color(color.gray,   "", inline="h2", group=gL)
h3 = input.price(0.0, "水平線3", inline="h3", group=gL)
c3 = input.color(color.gray,   "", inline="h3", group=gL)

// ---------------- UT Bot ----------------
src   = useHA ? request.security(ticker.heikinashi(syminfo.tickerid), timeframe.period, close, lookahead=barmerge.lookahead_off) : close
nLoss = keyValue * ta.atr(atrLen)

var float trail = na
prevT = nz(trail[1])
trail := src > prevT and src[1] > prevT ? math.max(prevT, src - nLoss) :
         src < prevT and src[1] < prevT ? math.min(prevT, src + nLoss) :
         src > prevT ? src - nLoss : src + nLoss

var int dir = 0
dir := src[1] < prevT and src > prevT ? 1 : src[1] > prevT and src < prevT ? -1 : nz(dir[1])

// v6 は and/or が遅延評価なので、クロス判定は先に毎バー計算しておく
utUp   = ta.crossover(src, trail)
utDn   = ta.crossunder(src, trail)
utBuy  = src > trail and utUp
utSell = src < trail and utDn

plot(showUT ? trail : na, "UT トレーリングストップ", dir == 1 ? color.green : dir == -1 ? color.red : color.gray, 2)
plotshape(utBuy,  "Buy",  shape.labelup,   location.belowbar, color.green, text="Buy",  textcolor=color.white, size=size.tiny)
plotshape(utSell, "Sell", shape.labeldown, location.abovebar, color.red,   text="Sell", textcolor=color.white, size=size.tiny)
barcolor(barCol ? (src > trail ? color.green : color.red) : na)

// ---------------- 平均線 ----------------
ma(len) => maType == "EMA" ? ta.ema(close, len) : ta.sma(close, len)
plot(show1 ? ma(len1) : na, "MA25",  color.orange,               maW)
plot(show2 ? ma(len2) : na, "MA75",  color.yellow,               maW)
plot(show3 ? ma(len3) : na, "MA200", color.rgb(0, 191, 255),     maW)

// ---------------- 前日 / 当日 高値・安値 (UTC日で自前集計) ----------------
tShift  = time - dayStartUTC * 3600000
dNum    = math.floor(tShift / 86400000)
dChange = na(dNum[1]) or dNum != dNum[1]

var float curH = na
var float curL = na
var float pdh  = na
var float pdl  = na
if dChange
    pdh  := curH
    pdl  := curL
    curH := high
    curL := low
else
    curH := math.max(nz(curH, high), high)
    curL := math.min(nz(curL, low), low)

// 前日: 太さ4・点線 / 当日: 太さ2・破線 (plot は線種を変えられないので line で描画)
var line pdhLn = na
var line pdlLn = na
var line cdhLn = na
var line cdlLn = na

mkDayLine(float y, color c, int w, string st) =>
    line.new(bar_index, y, bar_index, y, color=c, width=w, style=st)

if dChange
    pdhLn := showPD and not na(pdh) ? mkDayLine(pdh, hiCol, 4, line.style_dotted) : na
    pdlLn := showPD and not na(pdl) ? mkDayLine(pdl, loCol, 4, line.style_dotted) : na
    cdhLn := showCD ? mkDayLine(curH, hiCol, 2, line.style_dashed) : na
    cdlLn := showCD ? mkDayLine(curL, loCol, 2, line.style_dashed) : na
else
    if not na(pdhLn)
        line.set_x2(pdhLn, bar_index)
    if not na(pdlLn)
        line.set_x2(pdlLn, bar_index)
    if showCD
        if curH != curH[1]
            cdhLn := mkDayLine(curH, hiCol, 2, line.style_dashed)
        else
            line.set_x2(cdhLn, bar_index)
        if curL != curL[1]
            cdlLn := mkDayLine(curL, loCol, 2, line.style_dashed)
        else
            line.set_x2(cdlLn, bar_index)

// ---------------- ストキャス 4時間足 GC / DC 背景 ----------------
// 天井・底ゾーン: クロス直前の %K か %D が 底(7)以下 で GC → 1 / 天井(93)以上 で DC → -1
// 状態は次の反対シグナルまで維持 (前回と同じく色を塗り続ける)
stochState(bool conf, bool zone, float hiTh, float loTh) =>
    k  = ta.sma(ta.stoch(close, high, low, kLen), kSm)
    d  = ta.sma(k, dSm)
    up = ta.crossover(k, d)
    dn = ta.crossunder(k, d)
    gc = up and (not zone or math.min(k[1], d[1]) <= loTh)
    dc = dn and (not zone or math.max(k[1], d[1]) >= hiTh)
    var int st = 0
    st := gc ? 1 : dc ? -1 : st
    conf ? st[1] : st

stState = request.security(syminfo.tickerid, stTF, stochState(stConf, stMode == "天井・底ゾーン", stHi, stLo),
     lookahead = stConf ? barmerge.lookahead_on : barmerge.lookahead_off)

stGC = stState == 1  and nz(stState[1]) != 1
stDC = stState == -1 and nz(stState[1]) != -1
bgcolor(showBG ? (stState == 1 ? color.new(color.green, bgTransp) : stState == -1 ? color.new(color.red, bgTransp) : na) : na, title="ストキャス GC/DC 背景")

// ---------------- 高値・安値の数字 (ジグザグ: 天井と底を交互に) ----------------
lblSize = pivSize == "small" ? size.small : pivSize == "large" ? size.large : size.normal

// Buy/Sell マークと重ならないように: 近く(±2本)に Sell があれば高値の数字を上へ、
// Buy があれば安値の数字を下へずらす (空行を足して押し出す)
var sellBars = array.new_int()
var buyBars  = array.new_int()
if utSell
    array.push(sellBars, bar_index)
if utBuy
    array.push(buyBars, bar_index)
if array.size(sellBars) > 300
    array.shift(sellBars)
if array.size(buyBars) > 300
    array.shift(buyBars)

nearSig(array<int> bars, int x) =>
    bool hit = false
    for b in bars
        if math.abs(b - x) <= 2
            hit := true
    hit

numText(string t, bool isHigh, int x) =>
    isHigh ? (nearSig(sellBars, x) ? t + "\n \n " : t) : (nearSig(buyBars, x) ? " \n \n" + t : t)

mkZZLbl(float y, int x, bool isHigh) =>
    label.new(x, y, numText(str.tostring(y, format.mintick), isHigh, x),
         style = isHigh ? label.style_label_down : label.style_label_up,
         color=color.new(color.white, 100), textcolor=color.white, size=lblSize, text_formatting=text.format_bold)

// 反転の幅
zzAtr = ta.atr(zzAtrLen)
zzThr = zzMode == "ATR倍数" ? zzAtrMult * zzAtr : zzPips * zzPip

// zDir =  1: 上昇の波 (天井を探している)  → 高値更新で天井候補を更新 / 天井から zzThr 下げたら天井確定
// zDir = -1: 下降の波 (底を探している)    → 安値更新で底候補を更新   / 底から zzThr 上げたら底確定
// 確定したら必ず反対側を探すので、天井→底→天井… と交互になる
var int   zDir   = 1
var float zExt   = na
var int   zBar   = na
var label zLbl   = na
var line  zLn    = na
var zzH = array.new_label()
var zzL = array.new_label()

if showZZ and not na(zzThr)
    if na(zExt)
        zExt := high
        zBar := bar_index
        zLbl := mkZZLbl(high, bar_index, true)
        array.push(zzH, zLbl)
    else if zDir == 1
        if high >= zExt
            zExt := high
            zBar := bar_index
            label.set_xy(zLbl, zBar, zExt)
            if not na(zLn)
                line.set_xy2(zLn, zBar, zExt)
        else if low <= zExt - zzThr
            // 天井確定 → 底を探す
            pB = zBar
            pP = zExt
            zDir := -1
            zExt := low
            zBar := bar_index
            zLbl := mkZZLbl(low, bar_index, false)
            array.push(zzL, zLbl)
            zLn := zzLine ? line.new(pB, pP, zBar, zExt, color=zzLineCol, width=1) : na
    else
        if low <= zExt
            zExt := low
            zBar := bar_index
            label.set_xy(zLbl, zBar, zExt)
            if not na(zLn)
                line.set_xy2(zLn, zBar, zExt)
        else if high >= zExt + zzThr
            // 底確定 → 天井を探す
            pB = zBar
            pP = zExt
            zDir := 1
            zExt := high
            zBar := bar_index
            zLbl := mkZZLbl(high, bar_index, true)
            array.push(zzH, zLbl)
            zLn := zzLine ? line.new(pB, pP, zBar, zExt, color=zzLineCol, width=1) : na

if array.size(zzH) > 150
    label.delete(array.shift(zzH))
if array.size(zzL) > 150
    label.delete(array.shift(zzL))

// ---------------- 表示範囲の最高値・最安値 (DMM風) ----------------
// 画面に表示されている範囲の中で一番高い足/安い足を探して価格を出す (スクロールすると更新)
inVis = time >= chart.left_visible_bar_time and time <= chart.right_visible_bar_time
var float visH    = na
var float visL    = na
var int   visHBar = na
var int   visLBar = na
if inVis and not inVis[1]
    visH    := high
    visL    := low
    visHBar := bar_index
    visLBar := bar_index
else if inVis
    if high >= visH
        visH    := high
        visHBar := bar_index
    if low <= visL
        visL    := low
        visLBar := bar_index

var label visHLbl = na
var label visLLbl = na
if barstate.islast
    label.delete(visHLbl)
    label.delete(visLLbl)
    if showVis and not na(visH)
        visHLbl := label.new(visHBar, visH, numText("▼ " + str.tostring(visH, format.mintick), true, visHBar), style=label.style_label_down,
             color=color.new(color.white, 100), textcolor=color.white, size=lblSize, text_formatting=text.format_bold)
        visLLbl := label.new(visLBar, visL, numText("▲ " + str.tostring(visL, format.mintick), false, visLBar), style=label.style_label_up,
             color=color.new(color.white, 100), textcolor=color.white, size=lblSize, text_formatting=text.format_bold)
    // ジグザグの数字を最新の位置・Buy/Sell の有無で書き直し、
    // 最高値/最安値と同じ足の数字は隠して二重表示を防ぐ
    for l in zzH
        label.set_text(l, numText(str.tostring(label.get_y(l), format.mintick), true, label.get_x(l)))
        label.set_textcolor(l, showVis and label.get_x(l) == visHBar ? color.new(color.white, 100) : color.white)
    for l in zzL
        label.set_text(l, numText(str.tostring(label.get_y(l), format.mintick), false, label.get_x(l)))
        label.set_textcolor(l, showVis and label.get_x(l) == visLBar ? color.new(color.white, 100) : color.white)

// ---------------- 水平線 / 価格ラベル (最新バーで描き直し) ----------------
var lns  = array.new_line()
var lbls = array.new_label()

mkLbl(float y, string title, color bg, color tc) =>
    label.new(bar_index + 1, y, title + " " + str.tostring(y, format.mintick),
         style=label.style_label_left, color=bg, textcolor=tc, size=size.normal,
         text_formatting=text.format_bold)

mkLine(float y, color c) =>
    line.new(bar_index - 1, y, bar_index, y, extend=extend.both, color=c, style=line.style_dashed, width=1)

if barstate.islast
    while array.size(lns) > 0
        line.delete(array.pop(lns))
    while array.size(lbls) > 0
        label.delete(array.pop(lbls))
    if h1 > 0
        array.push(lns, mkLine(h1, c1))
    if h2 > 0
        array.push(lns, mkLine(h2, c2))
    if h3 > 0
        array.push(lns, mkLine(h3, c3))
    if showLbl and showPD and not na(pdh)
        array.push(lbls, mkLbl(pdh, "前日高値", hiCol, color.white))
        array.push(lbls, mkLbl(pdl, "前日安値", loCol, color.white))
    if showLbl and showCD
        array.push(lbls, mkLbl(curH, "当日高値", hiCol, color.white))
        array.push(lbls, mkLbl(curL, "当日安値", loCol, color.white))

// ---------------- アラート ----------------
alertcondition(utBuy,  "UT Buy",  "UT Bot Buy {{ticker}} {{close}}")
alertcondition(utSell, "UT Sell", "UT Bot Sell {{ticker}} {{close}}")
alertcondition(not na(pdh) and high >= pdh and high[1] < pdh and not dChange, "前日高値ブレイク", "前日高値ブレイク {{ticker}} {{close}}")
alertcondition(not na(pdl) and low  <= pdl and low[1]  > pdl and not dChange, "前日安値ブレイク", "前日安値ブレイク {{ticker}} {{close}}")
alertcondition(stGC, "4H ストキャス GC", "4H ストキャス ゴールデンクロス(底) {{ticker}} {{close}}")
alertcondition(stDC, "4H ストキャス DC", "4H ストキャス デッドクロス(天井) {{ticker}} {{close}}")
